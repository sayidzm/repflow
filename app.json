{
  "expo": {
    "name": "RepFlow",
    "slug": "repflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "repflow",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sayid.repflow"
    },
    "android": {
      "package": "com.sayid.repflow"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
